# Step 2 of 2: scramble control flow and encrypt strings/numbers in the
# already-renamed jar from ProGuard. Mixin classes and the entry point keep
# their logic untouched here too, on top of already keeping their names.

exempt: [
    "class{^com\\/example\\/addon\\/mixin\\/}",
    "class{^com\\/example\\/addon\\/AddonTemplate$}"
]

stringEncryption {
  type: STANDARD
  enabled: true
  exempt: []
}

numberEncryption {
  enabled: true
  exempt: []
}

flowException {
  enabled: true
  strength: AGGRESSIVE
  exempt: []
}

flowCondition {
  enabled: true
  exempt: []
}

flowRange {
  enabled: true
  exempt: []
}

flowSwitch {
  enabled: true
  exempt: []
}

outliner {
  enabled: true
  exempt: []
}

# renamers stay off here - ProGuard already renamed everything;
# running two renamers back to back tends to break things
classRenamer { enabled: false }
methodRenamer { enabled: false }
fieldRenamer { enabled: false }
