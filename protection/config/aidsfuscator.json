{
  "in": "input.jar",
  "out": "output.jar",
  "libs": "libs/",
  "dictionary": "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ",
  "computeFrames": true,
  "watermark": "",
  "aggressiveOverload": true,
  "exclusionPresets": ["api", "mc-fabric"],
  "transformers": {
    "trim": { "enabled": false, "classes": false, "fields": false, "methods": false },
    "renameFields": { "enabled": true, "preserveRecordNames": true, "keepSerializableNames": false, "prefix": "", "shuffle": true },
    "renameMethods": { "enabled": true, "prefix": "", "shuffle": true },
    "renameClasses": { "enabled": false, "prefix": "", "mixinPrefix": "b.", "renameSourceFile": true, "randomize": true },
    "localNames": { "enabled": true },
    "lineNumbers": { "enabled": true, "remove": true },
    "methodSalting": { "enabled": false },
    "classSalting": { "enabled": false, "unifyAccess": false },
    "fixConstants": { "enabled": false },
    "integerEncrypt": { "enabled": false },
    "encryptStrings": { "enabled": false },
    "flow": { "enabled": false },
    "numberObfuscation": { "enabled": false },
    "referenceObfuscation": { "enabled": false }
  }
}
