{
  "schemaVersion": 1,
  "id": "chicken-client",
  "version": "${version}",
  "name": "Chicken Client",
  "description": "Chicken Client - standalone Fabric client: modules, settings, config, ClickGUI and a NanoVG HUD without any other client framework.",
  "authors": [
    "MasQ"
  ],
  "contact": {
    "sources": "https://github.com/masqqg/Chciken-addon"
  },
  "icon": "assets/template/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.chicken.client.ChickenClient"
    ]
  },
  "mixins": [
    "chicken-client.mixins.json"
  ],
  "depends": {
    "java": ">=${jdk_version}",
    "minecraft": "${minecraft_version}",
    "fabricloader": ">=0.16.0",
    "fabric-api": "*",
    "geckolib": ">=5.4.0"
  }
}
